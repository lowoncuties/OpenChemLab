# Host port exposed by docker compose.
LCMS_HTTP_PORT=8000

# Leave empty when the frontend is served by the backend from the same container.
VITE_API_BASE_URL=

# Only needed when a different origin will call the API directly.
LCMS_CORS_ORIGINS=

# Optional: comma-separated origins if browsers call the API from another host
# (e.g. SPA at https://openchemlab.org and API_BASE https://api.openchemlab.org).
# LCMS_CORS_ORIGINS=https://openchemlab.org

# Optional ThermoRawFileParser overrides for Docker.
# Usually you can leave these empty and place the extracted official release under:
#   ./.tools/ThermoRawFileParser/
THERMO_RAW_PARSER_BIN=
THERMO_RAW_PARSER_DIR=

# Optional Docker image tag override.
APP_IMAGE_TAG=latest
