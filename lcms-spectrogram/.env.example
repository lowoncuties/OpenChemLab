# Host port exposed by docker compose.
LCMS_HTTP_PORT=8000

# Build target:
# - runtime: deploy the web app without Thermo RAW conversion support
# - runtime-thermo: also build and bundle ThermoRawFileParser for Linux
# Review the ThermoRawFileParser and RawFileReader license terms before using runtime-thermo.
DOCKER_BUILD_TARGET=runtime

# Leave empty when the frontend is served by the backend from the same container.
VITE_API_BASE_URL=

# Only needed when a different origin will call the API directly.
LCMS_CORS_ORIGINS=

# Optional Docker image tag override.
APP_IMAGE_TAG=latest
